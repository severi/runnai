# Optional if using `claude login` (Pro/Max subscription).
# Set this for API billing instead.
ANTHROPIC_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: fallback if OAuth tokens file doesn't exist
STRAVA_REFRESH_TOKEN=
# Required for LLM evals (promptfoo judge model)
EVAL_ANTHROPIC_API_KEY=
# Intervals.icu (optional — for plan export)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# Garmin Connect (strength set data — Strava exposes none).
# Used by garmin_auth; MFA is prompted once in-session and then cached.
GARMIN_EMAIL=
GARMIN_PASSWORD=
