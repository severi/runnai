# Optional if using `claude login` (Pro/Max subscription).
# Set this for API billing instead.
ANTHROPIC_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: fallback if OAuth tokens file doesn't exist
STRAVA_REFRESH_TOKEN=
# Required for LLM evals (promptfoo judge model)
EVAL_ANTHROPIC_API_KEY=
# Intervals.icu (optional — for plan export)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
# Polar AccessLink (optional, Garmin installs) — pushes Polar sessions to Garmin Connect.
# Register a client at https://admin.polaraccesslink.com, redirect URL http://localhost:5000/oauth2_callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
